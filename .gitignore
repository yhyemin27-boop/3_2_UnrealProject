# =========================================================================
# Unreal Engine Gitignore Template
# =========================================================================

# 빌드 및 실행 시 자동 생성되는 임시 폴더들 (핵심 제외 대상)
Binaries/
Build/
DerivedDataCache/
Intermediate/
Saved/

# 패키징(빌드) 결과물이 저장되는 폴더
BuildArtifacts/

# 에셋 스토어 등에서 임시로 다운로드되는 파일
Plugins/Developer/

# C++ 프로젝트 프로젝트 파일 및 솔루션 파일
*.sln
*.vcxproj
*.vcxproj.filters
*.vcxproj.user
*.suo
.vs/

# Visual Studio Code 관련 설정 폴더
.vscode/

# Rider IDE 관련 설정 폴더
.idea/

# Mac 환경 전용 임시 파일 및 메타데이터
.DS_Store

# 복구 및 백업용 임시 파일
*.bak
*.com
*.class
*.dll
*.exe
*.pdb
*.obj

# =========================================================================
# 예외 처리 및 포트폴리오 용량 다이어트 설정
# =========================================================================
!Config/
!Content/
!Source/

Content/StarterContent/
Content/Isometric-Interiors/Meshes/

# 대용량 미디어 및 그래픽 에셋 제외
*.mp4
*.avi
*.wav
*.fbx
*.obj

*.umap